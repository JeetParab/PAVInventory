<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="SidebarBrush" Color="#1B2430"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#2F6FED"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#1F5CD6"/>
  <SolidColorBrush x:Key="BgBrush" Color="#F3F5F7"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="TextBrush" Color="#1A2332"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#5C6B7A"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#E3E7EC"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#D13438"/>
  <SolidColorBrush x:Key="SidebarHoverBrush" Color="#243042"/>
  <SolidColorBrush x:Key="SidebarTextBrush" Color="#D5DCE6"/>
  <SolidColorBrush x:Key="RowAltBrush" Color="#F8FAFC"/>
  <SolidColorBrush x:Key="HeaderBrush" Color="#F7F9FB"/>
  <SolidColorBrush x:Key="HoverBrush" Color="#F0F4FA"/>
  <SolidColorBrush x:Key="OverlayBrush" Color="#88FFFFFF"/>
  <SolidColorBrush x:Key="DangerBorderBrush" Color="#F0C0C2"/>
  <SolidColorBrush x:Key="WarnBgBrush" Color="#FFF6E8"/>
  <SolidColorBrush x:Key="WarnBorderBrush" Color="#F0D7A8"/>
  <SolidColorBrush x:Key="ConnectedBrush" Color="#3BB273"/>
  <SolidColorBrush x:Key="DisconnectedBrush" Color="#D13438"/>

  <!-- Design-system additions -->
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#E6EEFD"/>
  <SolidColorBrush x:Key="SidebarActiveBgBrush" Color="#26395A"/>
  <SolidColorBrush x:Key="SidebarActiveFgBrush" Color="#9CC0FF"/>
  <SolidColorBrush x:Key="FloatingTileBrush" Color="#CCFFFFFF"/>
  <SolidColorBrush x:Key="SidebarMutedBrush" Color="#8493A8"/>
  <SolidColorBrush x:Key="SidebarBorderBrush" Color="#2A3545"/>
  <SolidColorBrush x:Key="RowLineBrush" Color="#EDF0F4"/>

  <!-- Scrollbars -->
  <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#00000000"/>
  <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#C5CDD6"/>
  <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#A8B4C2"/>
  <SolidColorBrush x:Key="ScrollBarThumbDragBrush" Color="#8A98A8"/>

  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#1A2332"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#1A2332"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#5C6B7A"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#1A2332"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#F3F5F7"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2F6FED"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2F6FED"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
</ResourceDictionary>
