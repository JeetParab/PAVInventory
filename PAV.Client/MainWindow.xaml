<Window x:Class="PAV.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PAV.Client.Views"
        Title="PAV Inventory"
        Height="800" Width="1280"
        MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">
  <Window.InputBindings>
    <KeyBinding Gesture="Ctrl+F" Command="{Binding FocusInventorySearchCommand}"/>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding Inventory.AddCommand}"/>
    <KeyBinding Key="F5" Command="{Binding Inventory.LoadCommand}"/>
  </Window.InputBindings>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="18"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" Width="212">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Visible"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
              <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="18,20,18,12">
          <TextBlock Text="PAV" FontSize="11" FontWeight="Bold" Foreground="#8AA0C8"/>
          <TextBlock Text="Inventory" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,2,0,0"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Padding="16,14" BorderBrush="#2A3545" BorderThickness="0,1,0,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource DisconnectedBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsConnected}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource ConnectedBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding ConnectionLabel}" Foreground="#A8B4C4" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock Text="{Binding UserLine}" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding RoleLine}" Foreground="#8AA0C8" FontSize="11" Margin="0,1,0,8"/>
            <Button Content="Sign out" Style="{StaticResource SecondaryButton}" Command="{Binding SignOutCommand}"
                    HorizontalAlignment="Stretch" Padding="8,5" FontSize="12"/>
          </StackPanel>
        </Border>

        <DockPanel Margin="0,8,0,8">
          <RadioButton DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Content="Settings"
                       Tag="&#xE713;"
                       IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Settings, Mode=OneWay}"
                       Command="{Binding GoCommand}" CommandParameter="Settings"/>
          <StackPanel>
            <RadioButton Style="{StaticResource NavButton}" Content="Dashboard"
                         Tag="&#xE80F;"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Dashboard, Mode=OneWay}"
                         Command="{Binding GoCommand}" CommandParameter="Dashboard"/>
            <RadioButton Style="{StaticResource NavButton}" Content="Inventory"
                         Tag="&#xE8FD;"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Inventory, Mode=OneWay}"
                         Command="{Binding GoCommand}" CommandParameter="Inventory"/>
            <RadioButton Style="{StaticResource NavButton}" Content="IP Inventory"
                         Tag="&#xE968;"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=IpInventory, Mode=OneWay}"
                         Command="{Binding GoCommand}" CommandParameter="IpInventory"/>
            <RadioButton Style="{StaticResource NavButton}" Content="Stock"
                         Tag="&#xE7BF;"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Stock, Mode=OneWay}"
                         Command="{Binding GoCommand}" CommandParameter="Stock"/>
            <RadioButton Style="{StaticResource NavButton}" Content="Toner"
                         Tag="&#xE749;"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Toner, Mode=OneWay}"
                         Command="{Binding GoCommand}" CommandParameter="Toner"/>
            <RadioButton Style="{StaticResource NavButton}" Content="Users"
                         Tag="&#xE716;"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Users, Mode=OneWay}"
                         Command="{Binding GoCommand}" CommandParameter="Users"/>
            <RadioButton Style="{StaticResource NavButton}" Content="Locations"
                         Tag="&#xE707;"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Locations, Mode=OneWay}"
                         Command="{Binding GoCommand}" CommandParameter="Locations"/>
          </StackPanel>
        </DockPanel>
      </DockPanel>
    </Border>

    <Border Grid.Column="1" Background="{DynamicResource SidebarBrush}" Cursor="Hand"
            ToolTip="Show or hide the side panel">
      <Border.InputBindings>
        <MouseBinding Gesture="LeftClick" Command="{Binding ToggleSidebarCommand}"/>
      </Border.InputBindings>
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="#8AA0C8" FontSize="14" FontWeight="Bold">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Text" Value="‹"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                <Setter Property="Text" Value="›"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Border>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{DynamicResource WarnBgBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsConnected}" Value="False">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Retry" Style="{StaticResource PrimaryButton}"
                  Command="{Binding RetryCommand}" Padding="14,6"/>
          <StackPanel>
            <TextBlock Text="Cannot open the shared database." FontWeight="SemiBold"/>
            <TextBlock Text="Check the shared folder path and that you can write to it." Style="{StaticResource MutedText}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1" Margin="20,16,20,16">
        <views:DashboardView DataContext="{Binding Dashboard}">
          <views:DashboardView.Style>
            <Style TargetType="UserControl">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Dashboard">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </views:DashboardView.Style>
        </views:DashboardView>

        <views:InventoryView DataContext="{Binding Inventory}">
          <views:InventoryView.Style>
            <Style TargetType="UserControl">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Inventory">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </views:InventoryView.Style>
        </views:InventoryView>

        <views:IpInventoryView DataContext="{Binding IpInventory}">
          <views:IpInventoryView.Style>
            <Style TargetType="UserControl">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="IpInventory">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </views:IpInventoryView.Style>
        </views:IpInventoryView>

        <views:StockView DataContext="{Binding Stock}">
          <views:StockView.Style>
            <Style TargetType="UserControl">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Stock">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </views:StockView.Style>
        </views:StockView>

        <views:StockView DataContext="{Binding Toner}">
          <views:StockView.Style>
            <Style TargetType="UserControl">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Toner">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </views:StockView.Style>
        </views:StockView>

        <views:UsersView DataContext="{Binding Users}">
          <views:UsersView.Style>
            <Style TargetType="UserControl">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Users">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </views:UsersView.Style>
        </views:UsersView>

        <views:LocationsView DataContext="{Binding Locations}">
          <views:LocationsView.Style>
            <Style TargetType="UserControl">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Locations">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </views:LocationsView.Style>
        </views:LocationsView>

        <views:SettingsView DataContext="{Binding Settings}">
          <views:SettingsView.Style>
            <Style TargetType="UserControl">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Settings">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </views:SettingsView.Style>
        </views:SettingsView>
      </Grid>
    </Grid>
  </Grid>
</Window>
