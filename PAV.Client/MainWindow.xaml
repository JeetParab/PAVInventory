<Window x:Class="PAV.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PAV | Physical Asset Management"
        Height="800" Width="1280"
        MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource BgBrush}">
  <Window.InputBindings>
    <KeyBinding Gesture="Ctrl+F" Command="{Binding FocusInventorySearchCommand}"/>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding Inventory.AddCommand}"/>
    <KeyBinding Key="F5" Command="{Binding Inventory.LoadCommand}"/>
  </Window.InputBindings>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Width" Value="200"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
              <Setter Property="Width" Value="48"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Margin="20,18,16,14" Visibility="{Binding SidebarCollapsed, Converter={StaticResource BoolToVisInv}}">
            <TextBlock Text="PAV" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock Text="Physical Asset Management" FontSize="11.5"
                       Foreground="{DynamicResource SidebarMutedBrush}" Margin="0,1,0,0"/>
          </StackPanel>
          <Border Height="1" Margin="16,0,16,6" Background="{DynamicResource SidebarBorderBrush}"
                  Visibility="{Binding SidebarCollapsed, Converter={StaticResource BoolToVisInv}}"/>
          <Border Height="44" Visibility="{Binding SidebarCollapsed, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Padding="16,12,16,14" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,1,0,0">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource DisconnectedBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsConnected}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource ConnectedBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding ConnectionLabel}" Foreground="{DynamicResource SidebarTextBrush}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock Text="{Binding UserLine}" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding RoleLine}" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="11" Margin="0,1,0,10"/>
            <Button Content="Sign out" Style="{StaticResource SidebarButton}" Command="{Binding SignOutCommand}"
                    HorizontalAlignment="Stretch"/>
          </StackPanel>
        </Border>

        <DockPanel Margin="0,4,0,8">
          <StackPanel DockPanel.Dock="Bottom">
            <Border Height="1" Margin="16,6,16,6" Background="{DynamicResource SidebarBorderBrush}"
                    Visibility="{Binding SidebarCollapsed, Converter={StaticResource BoolToVisInv}}"/>
            <RadioButton Style="{StaticResource NavButton}" Content="Settings"
                         Tag="&#xE713;"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Settings, Mode=OneWay}"
                         Command="{Binding GoCommand}" CommandParameter="Settings"/>
          </StackPanel>
          <StackPanel>
            <RadioButton Style="{StaticResource NavButton}" Content="Dashboard"
                         Tag="&#xE80F;"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Dashboard, Mode=OneWay}"
                         Command="{Binding GoCommand}" CommandParameter="Dashboard"/>
            <RadioButton Style="{StaticResource NavButton}" Content="Inventory"
                         Tag="&#xE8FD;"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Inventory, Mode=OneWay}"
                         Command="{Binding GoCommand}" CommandParameter="Inventory"/>
            <RadioButton Style="{StaticResource NavButton}" Content="Peripherals"
                         Tag="&#xE8F1;"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Peripherals, Mode=OneWay}"
                         Command="{Binding GoCommand}" CommandParameter="Peripherals"/>
            <RadioButton Style="{StaticResource NavButton}" Content="IP Inventory"
                         Tag="&#xE968;"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=IpInventory, Mode=OneWay}"
                         Command="{Binding GoCommand}" CommandParameter="IpInventory"/>
            <RadioButton Style="{StaticResource NavButton}" Content="Pending"
                         Tag="&#xE7BA;"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Pending, Mode=OneWay}"
                         Command="{Binding GoCommand}" CommandParameter="Pending"/>
            <RadioButton Style="{StaticResource NavButton}" Content="Stock"
                         Tag="&#xE7BF;"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Stock, Mode=OneWay}"
                         Command="{Binding GoCommand}" CommandParameter="Stock"/>
            <RadioButton Style="{StaticResource NavButton}" Content="Toner"
                         Tag="&#xE749;"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Toner, Mode=OneWay}"
                         Command="{Binding GoCommand}" CommandParameter="Toner"/>
            <RadioButton Style="{StaticResource NavButton}" Content="Users"
                         Tag="&#xE716;"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Users, Mode=OneWay}"
                         Command="{Binding GoCommand}" CommandParameter="Users"/>
            <RadioButton Style="{StaticResource NavButton}" Content="Locations"
                         Tag="&#xE707;"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Locations, Mode=OneWay}"
                         Command="{Binding GoCommand}" CommandParameter="Locations"/>
          </StackPanel>
        </DockPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{DynamicResource WarnBgBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsConnected}" Value="False">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Retry" Style="{StaticResource PrimaryButton}"
                  Command="{Binding RetryCommand}" Padding="14,6"/>
          <StackPanel>
            <TextBlock Text="Cannot open the PAV database." FontWeight="SemiBold"/>
            <TextBlock Text="If you use a shared file, check the folder. If you use SQL Server, contact the PAV administrator." Style="{StaticResource MutedText}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1" Margin="20,16,20,16">
        <ContentControl x:Name="PageHost"/>
      </Grid>
    </Grid>

    <Button Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,-11,0"
            Panel.ZIndex="10" Width="22" Height="22" Cursor="Hand" FocusVisualStyle="{x:Null}"
            Command="{Binding ToggleSidebarCommand}" ToolTip="Show or hide the side panel">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" CornerRadius="6" Background="{DynamicResource FloatingTileBrush}"
                  BorderBrush="{DynamicResource ScrollBarThumbBrush}" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Button.Template>
      <Grid Width="7" Height="10">
        <Path Data="M 5,1 L 1.5,5 L 5,9" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
          <Path.Style>
            <Style TargetType="Path">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Path.Style>
        </Path>
        <Path Data="M 2,1 L 5.5,5 L 2,9" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
          <Path.Style>
            <Style TargetType="Path">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Path.Style>
        </Path>
      </Grid>
    </Button>
  </Grid>
</Window>
