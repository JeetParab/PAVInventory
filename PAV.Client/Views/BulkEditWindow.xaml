<Window x:Class="PAV.Client.Views.BulkEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize" Background="{DynamicResource BgBrush}">
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,8"/>
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"
               Text="Only filled fields are applied. Leave a box blank (or Unchanged) to keep the current value."/>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,8"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Apply" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" IsDefault="True"/>
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,10">
        <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,0,10">
        <TextBlock Text="Location" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding Locations}" SelectedValuePath="Id"
                  SelectedValue="{Binding LocationId}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel Grid.Row="1" Margin="0,0,0,10">
        <TextBlock Text="User" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding AssigneeChoices}"
                  Text="{Binding AssignedUserName, UpdateSourceTrigger=PropertyChanged}"
                  IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                  MaxDropDownHeight="360"
                  ToolTip="Unchanged keeps current assignment. Pick Unassigned to clear. Type a name or user id."/>
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
        <TextBlock Text="Designation" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Designation, UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>
      <StackPanel Grid.Row="2" Margin="0,0,0,10">
        <TextBlock Text="Hostname" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
        <TextBlock Text="IP Address" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>
      <StackPanel Grid.Row="3" Margin="0,0,0,10">
        <TextBlock Text="Domain" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>
      <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,10">
        <TextBlock Text="Collect By" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding CollectBy, UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>
      <StackPanel Grid.Row="4" Margin="0,0,0,10">
        <TextBlock Text="MFA" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding YesNo}" SelectedItem="{Binding MfaEnabled}"/>
      </StackPanel>
      <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,10">
        <TextBlock Text="Admin Rights" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding YesNo}" SelectedItem="{Binding AdminRights}"/>
      </StackPanel>
      <StackPanel Grid.Row="5" Margin="0,0,0,10">
        <TextBlock Text="USB Access" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding YesNo}" SelectedItem="{Binding UsbAccess}"/>
      </StackPanel>
      <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,10">
        <TextBlock Text="Last Connected" Style="{StaticResource FieldLabel}"/>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Today" Style="{StaticResource SecondaryButton}"
                  Command="{Binding LastConnectedTodayCommand}" Padding="12,6" Margin="6,0,0,0"/>
          <TextBox Text="{Binding LastConnectedText, UpdateSourceTrigger=LostFocus}"
                   VerticalContentAlignment="Center"/>
        </DockPanel>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
