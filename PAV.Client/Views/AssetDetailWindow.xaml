<Window x:Class="PAV.Client.Views.AssetDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Asset.AssetTag, StringFormat=Asset {0}}"
        Width="760" Height="820"
        MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">
  <DockPanel Margin="24,20,20,20">
    <Grid DockPanel.Dock="Top" Margin="0,0,8,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0">
        <TextBlock Text="{Binding Asset.AssetTag}" Style="{StaticResource PageTitle}" TextWrapping="Wrap"/>
        <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0">
          <Run Text="{Binding Asset.Category, Mode=OneWay}"/>
          <Run Text="  ·  "/>
          <Run Text="{Binding Asset.Status, Mode=OneWay}"/>
          <Run Text="  ·  Sr "/>
          <Run Text="{Binding Asset.SrNo, Mode=OneWay}"/>
        </TextBlock>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"
                Padding="14,8" Margin="0,0,8,0"/>
        <Button Content="Edit" Style="{StaticResource PrimaryButton}" Command="{Binding EditCommand}"
                Padding="16,8" IsEnabled="{Binding CanEdit}"/>
      </StackPanel>
    </Grid>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  FocusVisualStyle="{x:Null}" Padding="0,0,8,0" CanContentScroll="False">
      <StackPanel Margin="0,0,4,8">

        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="Basic information" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,14"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <StackPanel>
                <TextBlock Text="Asset ID" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.AssetTag}" Style="{StaticResource FieldValue}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.Category}" Style="{StaticResource FieldValue}"/>
              </StackPanel>

              <StackPanel Grid.Row="1">
                <TextBlock Text="Manufacturer" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.Manufacturer}" Style="{StaticResource FieldValue}"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Text="Model" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.Model}" Style="{StaticResource FieldValue}"/>
              </StackPanel>

              <StackPanel Grid.Row="2">
                <TextBlock Text="Serial Number" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.SerialNumber}" Style="{StaticResource FieldValue}"/>
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="2">
                <TextBlock Text="Hostname" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.Hostname}" Style="{StaticResource FieldValue}"/>
              </StackPanel>

              <StackPanel Grid.Row="3">
                <TextBlock Text="IP Address" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.IpAddress}" Style="{StaticResource FieldValue}"/>
              </StackPanel>
              <StackPanel Grid.Row="3" Grid.Column="2">
                <TextBlock Text="MAC Address" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.MacAddress}" Style="{StaticResource FieldValue}"/>
              </StackPanel>

              <StackPanel Grid.Row="4">
                <TextBlock Text="Processor" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.Processor}" Style="{StaticResource FieldValue}"/>
              </StackPanel>
              <StackPanel Grid.Row="4" Grid.Column="2">
                <TextBlock Text="RAM / Storage" Style="{StaticResource FieldLabel}"/>
                <TextBlock Style="{StaticResource FieldValue}">
                  <Run Text="{Binding Asset.Ram, Mode=OneWay}"/>
                  <Run Text="  ·  "/>
                  <Run Text="{Binding Asset.Storage, Mode=OneWay}"/>
                </TextBlock>
              </StackPanel>

              <StackPanel Grid.Row="5">
                <TextBlock Text="OS" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.OperatingSystem}" Style="{StaticResource FieldValue}"/>
              </StackPanel>
              <StackPanel Grid.Row="5" Grid.Column="2">
                <TextBlock Text="Domain" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.Domain}" Style="{StaticResource FieldValue}"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="20">
            <StackPanel>
              <TextBlock Text="Location" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,14"/>
              <TextBlock Text="Location" Style="{StaticResource FieldLabel}"/>
              <TextBlock Text="{Binding Asset.Location}" Style="{StaticResource FieldValue}"/>
              <TextBlock Text="Last Connected" Style="{StaticResource FieldLabel}"/>
              <TextBlock Text="{Binding Asset.LastConnected, StringFormat=dd MMM yyyy}" Style="{StaticResource FieldValue}"/>
              <TextBlock Text="Collect By" Style="{StaticResource FieldLabel}"/>
              <TextBlock Text="{Binding Asset.CollectBy}" Style="{StaticResource FieldValue}"/>
              <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
              <Border Style="{StaticResource StatusPill}" HorizontalAlignment="Left" Margin="0,0,0,4"
                      Background="{Binding Asset.Status, Converter={StaticResource StatusBrush}}">
                <TextBlock Text="{Binding Asset.Status}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{Binding Asset.Status, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"/>
              </Border>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="20" Grid.Column="2">
            <StackPanel>
              <TextBlock Text="Assignment" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,14"/>
              <TextBlock Text="Assigned User" Style="{StaticResource FieldLabel}"/>
              <TextBlock Text="{Binding Asset.AssignedUser}" Style="{StaticResource FieldValue}"/>
              <TextBlock Text="Designation" Style="{StaticResource FieldLabel}"/>
              <TextBlock Text="{Binding Asset.Designation}" Style="{StaticResource FieldValue}"/>
              <TextBlock Text="Alternate User" Style="{StaticResource FieldLabel}"/>
              <TextBlock Text="{Binding Asset.AlternateUser}" Style="{StaticResource FieldValue}"/>
              <TextBlock Text="Assigned Date" Style="{StaticResource FieldLabel}"/>
              <TextBlock Text="{Binding Asset.AssignedDate, StringFormat=dd MMM yyyy}" Style="{StaticResource FieldValue}"/>
            </StackPanel>
          </Border>
        </Grid>

        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="Compliance" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,14"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="DC Installed" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.DcInstalled}" Style="{StaticResource FieldValue}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="AV Installed" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.AvInstalled}" Style="{StaticResource FieldValue}"/>
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Office" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.MsOfficeVersion}" Style="{StaticResource FieldValue}"/>
              </StackPanel>
              <StackPanel Grid.Row="1">
                <TextBlock Text="MFA" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.MfaEnabled}" Style="{StaticResource FieldValue}"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Text="Ivanti" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.IvantiInstalled}" Style="{StaticResource FieldValue}"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="4">
                <TextBlock Text="Admin Rights" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.AdminRights}" Style="{StaticResource FieldValue}"/>
              </StackPanel>
              <StackPanel Grid.Row="2">
                <TextBlock Text="USB Access" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.UsbAccess}" Style="{StaticResource FieldValue}"/>
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="2">
                <TextBlock Text="Chrome Updated" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.ChromeUpdated}" Style="{StaticResource FieldValue}"/>
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="4">
                <TextBlock Text="PM Completed" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.PmCompleted}" Style="{StaticResource FieldValue}"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="Lifecycle" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,14"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Purchase Date" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.PurchaseDate, StringFormat=dd MMM yyyy}" Style="{StaticResource FieldValue}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Warranty Expiry" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding Asset.WarrantyExpiry, StringFormat=dd MMM yyyy}" Style="{StaticResource FieldValue}"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="Remarks" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding Asset.Remarks}" Style="{StaticResource FieldValue}" Margin="0"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="20">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="History" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,14"/>
            <TextBlock DockPanel.Dock="Top" Text="No history yet." Margin="0,0,0,4">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasHistory}" Value="False">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding HistoryItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="20"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
