<UserControl x:Class="PAV.Client.Views.IpInventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="IP Inventory" Style="{StaticResource PageTitle}" VerticalAlignment="Center" Margin="0,0,18,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <RadioButton Content="Assign" Style="{StaticResource PageTab}"
                     IsChecked="{Binding ShowAssign, Mode=OneWay}"
                     Command="{Binding ShowPageCommand}" CommandParameter="Assign"/>
        <RadioButton Content="Allocation list" Style="{StaticResource PageTab}"
                     IsChecked="{Binding ShowList, Mode=OneWay}"
                     Command="{Binding ShowPageCommand}" CommandParameter="List"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" Padding="12,8">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72C;" Style="{StaticResource BtnIcon}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <TextBlock Text="Refresh" Style="{StaticResource BtnLabel}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ImportWorkbookCommand}"
                IsEnabled="{Binding CanImport}" Padding="12,8">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8B5;" Style="{StaticResource BtnIcon}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <TextBlock Text="Import Excel" Style="{StaticResource BtnLabel}"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  Visibility="{Binding ShowAssign, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                   Visibility="{Binding Message, Converter={StaticResource StringToVis}}"/>

        <WrapPanel Margin="0,0,0,12">
          <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,8" MinWidth="120">
            <StackPanel>
              <TextBlock Text="Total" Style="{StaticResource MutedText}"/>
              <TextBlock Text="{Binding Total}" FontSize="22" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,8" MinWidth="120">
            <StackPanel>
              <TextBlock Text="Used" Style="{StaticResource MutedText}"/>
              <TextBlock Text="{Binding Used}" FontSize="22" FontWeight="SemiBold" Foreground="#107C41"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,8" MinWidth="120">
            <StackPanel>
              <TextBlock Text="Free" Style="{StaticResource MutedText}"/>
              <TextBlock Text="{Binding Free}" FontSize="22" FontWeight="SemiBold" Foreground="#2F6FED"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,8" MinWidth="120">
            <StackPanel>
              <TextBlock Text="Reserved" Style="{StaticResource MutedText}"/>
              <TextBlock Text="{Binding Reserved}" FontSize="22" FontWeight="SemiBold" Foreground="#C47B17"/>
            </StackPanel>
          </Border>
        </WrapPanel>

        <ItemsControl ItemsSource="{Binding Floors}" Margin="0,0,0,12">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource GhostButton}" Padding="0" Margin="0,0,10,10"
                      Command="{Binding DataContext.SelectFloorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}">
                <Border Width="188" Padding="12,10">
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatCard}">
                      <Setter Property="Width" Value="188"/>
                      <Setter Property="Padding" Value="12,10"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                          <Setter Property="BorderThickness" Value="2"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Data.Name}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Data.Cidr}" Style="{StaticResource MutedText}" Margin="0,2,0,6"/>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11">
                      <Run Text="Used "/>
                      <Run Text="{Binding Data.Used, Mode=OneWay}"/>
                      <Run Text="  ·  Free "/>
                      <Run Text="{Binding Data.Free, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Margin="0,6,0,0" FontWeight="SemiBold">
                      <Run Text="Next  "/>
                      <Run Text="{Binding Data.NextFreeIp, Mode=OneWay}"/>
                    </TextBlock>
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Style="{StaticResource Card}" Padding="16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.1*"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Get a free IP" FontWeight="SemiBold" Margin="0,0,0,4"/>
              <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                         Text="Select a floor. Next free is the lowest unused address. Random free picks any unused address on that floor — you can still change it in the dialog."/>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Selected"/>
              <TextBlock Margin="0,0,0,8">
                <Run Text="{Binding SelectedFloorName, Mode=OneWay}"/>
                <Run Text="  ·  "/>
                <Run Text="{Binding NextFreeIp, Mode=OneWay}"/>
              </TextBlock>
              <StackPanel Orientation="Horizontal">
                <Button Content="Assign next free IP" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AssignNextFreeCommand}"
                        IsEnabled="{Binding CanAssign}"/>
                <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Command="{Binding AssignRandomFreeCommand}"
                        IsEnabled="{Binding CanAssign}"
                        ToolTip="Pick a random free address on this floor instead of the next in sequence">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B1;" Style="{StaticResource BtnIcon}"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <TextBlock Text="Random free IP" Style="{StaticResource BtnLabel}"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Assign a specific IP" FontWeight="SemiBold" Margin="0,0,0,4"/>
              <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                         Text="Type any address in 172.16.101–107. If it is free it opens assign. If it is taken you will see who has it."/>
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Assign" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AssignCustomCommand}" Margin="8,0,0,0"
                        IsEnabled="{Binding CanAssign}"/>
                <Button DockPanel.Dock="Right" Content="Check" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CheckCommand}" Margin="8,0,0,0"/>
                <TextBox Text="{Binding CheckInput, UpdateSourceTrigger=PropertyChanged}"/>
              </DockPanel>
              <TextBlock Text="{Binding CheckResult.Message}" TextWrapping="Wrap" Margin="0,0,0,8"
                         Visibility="{Binding CheckResult, Converter={StaticResource NullToVis}}"/>
              <StackPanel Visibility="{Binding CheckIsTaken, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                <TextBlock>
                  <Run Text="{Binding CheckResult.Record.Status, Mode=OneWay}"/>
                  <Run Text="  ·  "/>
                  <Run Text="{Binding CheckResult.Record.AssignedUser, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap">
                  <Run Text="{Binding CheckResult.Record.AssignedDevice, Mode=OneWay}"/>
                  <Run Text="  ·  "/>
                  <Run Text="{Binding CheckResult.Record.Department, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Style="{StaticResource MutedText}">
                  <Run Text="{Binding CheckResult.Record.MacAddress, Mode=OneWay}"/>
                  <Run Text="  ·  "/>
                  <Run Text="{Binding CheckResult.Record.DeviceType, Mode=OneWay}"/>
                </TextBlock>
              </StackPanel>
              <Button Content="Release" Style="{StaticResource DangerButton}"
                      Command="{Binding ReleaseCommand}" HorizontalAlignment="Left"
                      Visibility="{Binding CheckIsTaken, Converter={StaticResource BoolToVis}}"
                      IsEnabled="{Binding CanAssign}"/>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="1" Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Assign custom IP" Style="{StaticResource PrimaryButton}" Command="{Binding AssignCustomCommand}"
                  IsEnabled="{Binding CanAssign}" Margin="0,0,8,0" Padding="10,6"/>
          <Button Content="Assign selected" Style="{StaticResource SecondaryButton}" Command="{Binding AssignSelectedCommand}"
                  IsEnabled="{Binding CanAssign}" Margin="0,0,8,0" Padding="10,6"/>
          <Button Content="Reserve" Style="{StaticResource SecondaryButton}" Command="{Binding ReserveSelectedCommand}"
                  IsEnabled="{Binding CanAssign}" Margin="0,0,8,0" Padding="10,6"/>
          <Button Content="Release" Style="{StaticResource DangerButton}" Command="{Binding ReleaseCommand}"
                  IsEnabled="{Binding CanAssign}" Padding="10,6"/>
        </StackPanel>
        <ComboBox DockPanel.Dock="Right" Width="130" Margin="0,0,8,0"
                  ItemsSource="{Binding StatusChoices}" SelectedItem="{Binding StatusFilter}"/>
        <ComboBox DockPanel.Dock="Right" Width="140" Margin="0,0,8,0"
                  ItemsSource="{Binding FloorFilters}" SelectedItem="{Binding SelectedListFloor}"/>
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0">
          <Run Text="{Binding VisibleCount, Mode=OneWay}"/>
          <Run Text=" rows"/>
        </TextBlock>
        <TextBox Margin="0,0,8,0" Text="{Binding ListSearch, UpdateSourceTrigger=PropertyChanged}"
                 VerticalContentAlignment="Center"
                 ToolTip="Search IP, user, device, MAC, department, notes"/>
      </DockPanel>
      <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="False"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  MouseDoubleClick="OnRowDoubleClick">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Floor" Binding="{Binding FloorName}" Width="90"/>
            <DataGridTextColumn Header="IP" Binding="{Binding Address}" Width="130"/>
            <DataGridTextColumn Header="Host" Binding="{Binding HostOctet}" Width="55"/>
            <DataGridTextColumn Header="Subnet" Binding="{Binding Subnet}" Width="130"/>
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
            <DataGridTextColumn Header="User" Binding="{Binding AssignedUser}" Width="150"/>
            <DataGridTextColumn Header="Device" Binding="{Binding AssignedDevice}" Width="220"/>
            <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="140"/>
            <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="140"/>
            <DataGridTextColumn Header="Type" Binding="{Binding DeviceType}" Width="110"/>
            <DataGridTextColumn Header="Assigned" Binding="{Binding DateAssigned, StringFormat=yyyy-MM-dd}" Width="100"/>
            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="220"/>
            <DataGridTextColumn Header="Updated" Binding="{Binding LastUpdated, StringFormat=yyyy-MM-dd}" Width="100"/>
            <DataGridTextColumn Header="By" Binding="{Binding AllocatedBy}" Width="120"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </DockPanel>
  </Grid>
</UserControl>
