<UserControl x:Class="PAV.Client.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" Margin="0,0,18,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <RadioButton Content="Items" Style="{StaticResource PageTab}"
                     IsChecked="{Binding ShowStock, Mode=OneWay}"
                     Command="{Binding ShowPageCommand}" CommandParameter="Stock"/>
        <RadioButton Content="Movements" Style="{StaticResource PageTab}"
                     IsChecked="{Binding ShowMovements, Mode=OneWay}"
                     Command="{Binding ShowPageCommand}" CommandParameter="Movements"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" Padding="12,8">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72C;" Style="{StaticResource BtnIcon}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <TextBlock Text="Refresh" Style="{StaticResource BtnLabel}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ImportCommand}"
                IsEnabled="{Binding CanManage}" Margin="0,0,8,0" Padding="12,8">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8B5;" Style="{StaticResource BtnIcon}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <TextBlock Text="Import Excel" Style="{StaticResource BtnLabel}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ExportCommand}"
                IsEnabled="{Binding CanExport}" Padding="12,8">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xEDE1;" Style="{StaticResource BtnIcon}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <TextBlock Text="Export" Style="{StaticResource BtnLabel}"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Visibility="{Binding ShowStock, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*" MinHeight="160"/>
        <RowDefinition Height="180"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                 Visibility="{Binding Message, Converter={StaticResource StringToVis}}"/>
      <WrapPanel Grid.Row="1" Margin="0,0,0,12">
        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,8" MinWidth="120">
          <StackPanel>
            <TextBlock Text="Items" Style="{StaticResource MutedText}"/>
            <TextBlock Text="{Binding ItemCount}" FontSize="22" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,8" MinWidth="120">
          <StackPanel>
            <TextBlock Text="On hand" Style="{StaticResource MutedText}"/>
            <TextBlock Text="{Binding OnHandUnits}" FontSize="22" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,8" MinWidth="120">
          <StackPanel>
            <TextBlock Text="Low stock" Style="{StaticResource MutedText}"/>
            <TextBlock Text="{Binding LowStock}" FontSize="22" FontWeight="SemiBold" Foreground="#C47B17"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,8" MinWidth="120">
          <StackPanel>
            <TextBlock Text="Out of stock" Style="{StaticResource MutedText}"/>
            <TextBlock Text="{Binding OutOfStock}" FontSize="22" FontWeight="SemiBold" Foreground="#D13438"/>
          </StackPanel>
        </Border>
      </WrapPanel>

      <DockPanel Grid.Row="2" Margin="0,0,0,10">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="+ Item" Style="{StaticResource SecondaryButton}" Command="{Binding AddItemCommand}"
                  IsEnabled="{Binding CanManage}" Margin="0,0,8,0" Padding="10,6"/>
          <Button Content="Edit" Style="{StaticResource SecondaryButton}" Command="{Binding EditItemCommand}"
                  IsEnabled="{Binding CanManage}" Margin="0,0,8,0" Padding="10,6"/>
          <Button Content="Receive" Style="{StaticResource SecondaryButton}" Command="{Binding ReceiveCommand}"
                  IsEnabled="{Binding CanMove}" Margin="0,0,8,0" Padding="10,6"/>
          <Button Content="Issue" Style="{StaticResource PrimaryButton}" Command="{Binding IssueCommand}"
                  IsEnabled="{Binding CanMove}" Margin="0,0,8,0" Padding="10,6"/>
          <Button Content="Return" Style="{StaticResource SecondaryButton}" Command="{Binding ReturnCommand}"
                  IsEnabled="{Binding CanMove}" Margin="0,0,8,0" Padding="10,6"/>
          <Button Content="Adjust" Style="{StaticResource SecondaryButton}" Command="{Binding AdjustCommand}"
                  IsEnabled="{Binding CanManage}" Margin="0,0,8,0" Padding="10,6"/>
          <Button Content="Check integrity" Style="{StaticResource SecondaryButton}" Command="{Binding IntegrityCommand}"
                  IsEnabled="{Binding CanManage}" Padding="10,6"/>
        </StackPanel>
        <ComboBox DockPanel.Dock="Right" Width="140" Margin="0,0,8,0"
                  ItemsSource="{Binding StatusChoices}" SelectedItem="{Binding StatusFilter}"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                Command="{Binding ToggleDetailColumnsCommand}" Margin="0,0,8,0" Padding="10,6"
                Content="{Binding DetailColumnsLabel}"
                ToolTip="Opening, received, returned, make/model and status stay available here"/>
        <TextBox Margin="0,0,8,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                 VerticalContentAlignment="Center"
                 ToolTip="Search name, manufacturer, model, category"/>
      </DockPanel>

      <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
        <DataGrid x:Name="ItemGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                  EnableRowVirtualization="True" EnableColumnVirtualization="False"
                  CanUserResizeColumns="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  PreviewMouseWheel="OnGridPreviewMouseWheel"
                  MouseDoubleClick="OnItemDoubleClick">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*" MinWidth="180"/>
            <DataGridTextColumn Header="On hand" Binding="{Binding OnHand}" Width="100"/>
            <DataGridTextColumn Header="Issued" Binding="{Binding Issued}" Width="100"/>
            <DataGridTextColumn Header="Make" Binding="{Binding Manufacturer}" Width="110" MinWidth="80"/>
            <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="130" MinWidth="80"/>
            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" MinWidth="80"/>
            <DataGridTextColumn Header="Min" Binding="{Binding MinimumQuantity}" Width="55"/>
            <DataGridTextColumn Header="Status" Binding="{Binding StockStatus}" Width="110"/>
            <DataGridTextColumn Header="Opening" Binding="{Binding Opening}" Width="80"/>
            <DataGridTextColumn Header="Received" Binding="{Binding Received}" Width="85"/>
            <DataGridTextColumn Header="Returned" Binding="{Binding Returned}" Width="85"/>
            <DataGridTextColumn Header="Adjusted" Binding="{Binding Adjusted}" Width="85"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0" Margin="0,10,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Margin="12,8,12,4" FontWeight="SemiBold">
            <Run Text="Recent movements"/>
            <Run Text="  ·  "/>
            <Run Text="{Binding Selected.Name, Mode=OneWay}"/>
          </TextBlock>
          <DataGrid ItemsSource="{Binding Movements}" SelectedItem="{Binding SelectedMovement}"
                    EnableColumnVirtualization="False"
                    CanUserResizeColumns="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    PreviewMouseWheel="OnGridPreviewMouseWheel">
            <DataGrid.Columns>
              <DataGridTextColumn Header="When" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
              <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="90"/>
              <DataGridTextColumn Header="Qty" Binding="{Binding SignedQuantity}" Width="60"/>
              <DataGridTextColumn Header="User" Binding="{Binding AssignedUser}" Width="180"/>
              <DataGridTextColumn Header="By" Binding="{Binding CreatedBy}" Width="120"/>
              <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="140"/>
              <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="240" MinWidth="120"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1" Visibility="{Binding ShowMovements, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,10">
        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                 VerticalContentAlignment="Center"
                 ToolTip="Search item, user, notes"/>
      </DockPanel>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
        <DataGrid ItemsSource="{Binding Movements}" SelectedItem="{Binding SelectedMovement}"
                  EnableRowVirtualization="True" EnableColumnVirtualization="False"
                  CanUserResizeColumns="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  PreviewMouseWheel="OnGridPreviewMouseWheel">
          <DataGrid.Columns>
            <DataGridTextColumn Header="When" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
            <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="220"/>
            <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="90"/>
            <DataGridTextColumn Header="Qty" Binding="{Binding SignedQuantity}" Width="60"/>
            <DataGridTextColumn Header="User" Binding="{Binding AssignedUser}" Width="180"/>
            <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="140"/>
            <DataGridTextColumn Header="By" Binding="{Binding CreatedBy}" Width="120"/>
            <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="140"/>
            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="240" MinWidth="120"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
