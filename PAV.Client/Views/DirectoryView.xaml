<UserControl x:Class="PAV.Client.Views.DirectoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="AD users" Style="{StaticResource PageTitle}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" Padding="12,8">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72C;" Style="{StaticResource BtnIcon}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <TextBlock Text="Refresh" Style="{StaticResource BtnLabel}"/>
          </StackPanel>
        </Button>
        <Button Content="Import AD users" Style="{StaticResource PrimaryButton}"
                Command="{Binding ImportAdCommand}"
                IsEnabled="{Binding CanImportAd}" Margin="0,0,8,0"/>
        <Button Content="Add to PAV users" Style="{StaticResource SecondaryButton}"
                Command="{Binding AddToPavCommand}"
                IsEnabled="{Binding CanAddToPav}"/>
      </StackPanel>
    </DockPanel>

    <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
               Text="{Binding Summary}"/>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="420"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="320" MinWidth="260"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
        <DockPanel>
          <TextBox DockPanel.Dock="Top" Margin="10,10,10,8"
                   Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                   VerticalContentAlignment="Center"
                   ToolTip="Search user id, name, email, department, employee ID"/>
          <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}"
                    EnableRowVirtualization="True" EnableColumnVirtualization="False"
                    CanUserResizeColumns="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTextColumn Header="User ID" Binding="{Binding Sam}" Width="130" MinWidth="90"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" MinWidth="120"/>
              <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="140"/>
              <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
              <DataGridTextColumn Header="Employee ID" Binding="{Binding EmployeeId}" Width="110"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
              <DataGridCheckBoxColumn Header="In PAV" Binding="{Binding InPav, Mode=OneWay}" Width="60" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
        <StackPanel>
          <TextBlock Text="Details" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
          <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource FieldValue}" Margin="0,0,0,10"
                     TextWrapping="Wrap"/>
          <TextBlock Text="User ID" Style="{StaticResource FieldLabel}"/>
          <TextBlock Text="{Binding Selected.Sam}" Style="{StaticResource FieldValue}" Margin="0,0,0,10"/>
          <TextBlock Text="Employee ID" Style="{StaticResource FieldLabel}"/>
          <TextBlock Text="{Binding Selected.EmployeeId}" Style="{StaticResource FieldValue}" Margin="0,0,0,10"/>
          <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
          <TextBlock Text="{Binding Selected.Email}" Style="{StaticResource FieldValue}" Margin="0,0,0,10"
                     TextWrapping="Wrap"/>
          <TextBlock Text="Department" Style="{StaticResource FieldLabel}"/>
          <TextBlock Text="{Binding Selected.Department}" Style="{StaticResource FieldValue}" Margin="0,0,0,10"
                     TextWrapping="Wrap"/>
          <TextBlock Text="Account" Style="{StaticResource FieldLabel}"/>
          <TextBlock Text="{Binding Selected.Status}" Style="{StaticResource FieldValue}" Margin="0,0,0,10"/>
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="Read-only snapshot from the AD workbook. Add to PAV users if you need them on the Users tab for assignment."/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
