<UserControl x:Class="PAV.Client.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <UserControl.InputBindings>
    <KeyBinding Gesture="Ctrl+F" Command="{Binding FocusSearchCommand}"/>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding AddCommand}"/>
    <KeyBinding Key="F5" Command="{Binding LoadCommand}"/>
  </UserControl.InputBindings>
  <Grid Margin="0,0,4,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{Binding PageHint}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center">
          <Run Text="{Binding VisibleCount, Mode=OneWay}"/>
          <Run Text=" of "/>
          <Run Text="{Binding Assets.Count, Mode=OneWay}"/>
          <Run Text=" assets"/>
          <Run Text="  ·  "/>
          <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
          <Run Text=" selected"/>
        </TextBlock>
        <Button Content="Clear filters" Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                Command="{Binding ClearFiltersCommand}" Padding="10,4" FontSize="12"
                Visibility="{Binding HasFilters, Converter={StaticResource BoolToVis}}"/>
      </StackPanel>
    </Grid>

    <DockPanel Grid.Row="1" Margin="0,0,0,14" LastChildFill="False">
      <TextBox x:Name="SearchBox" DockPanel.Dock="Left" Width="280" Margin="0,0,12,0"
               Padding="10,8" VerticalContentAlignment="Center"
               Tag="Search…"
               Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Search tag, serial, hostname, IP, user, location, category, status, model…"/>

      <Grid DockPanel.Dock="Left" Margin="0,0,8,0">
        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ToggleFiltersCommand}" Padding="12,8">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE71C;" Style="{StaticResource BtnIcon}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <TextBlock Text="Filters" Style="{StaticResource BtnLabel}"/>
          </StackPanel>
        </Button>
        <Popup IsOpen="{Binding FiltersOpen}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
          <Border Style="{StaticResource Card}" Width="300" Margin="0,8,0,0" Padding="16">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.16" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
              <TextBlock Text="Filters" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
              <TextBlock Text="Optional. Leave on All to show every asset." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
              <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding StatusChoices}" SelectedItem="{Binding StatusFilter}" Margin="0,0,0,10"/>
              <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding Categories}" SelectedValuePath="Id"
                        SelectedValue="{Binding CategoryFilter}" Margin="0,0,0,10">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="Location" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding Locations}" SelectedValuePath="Id"
                        SelectedValue="{Binding LocationFilter}" Margin="0,0,0,10">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="Manufacturer" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding Manufacturers}" SelectedItem="{Binding ManufacturerFilter}" Margin="0,0,0,10"/>
              <TextBlock Text="Assignment" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding AssignedChoices}" SelectedItem="{Binding AssignedFilter}" Margin="0,0,0,10"/>
              <StackPanel Visibility="{Binding ShowComputerTools, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Purpose" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding PurposeChoices}" SelectedItem="{Binding PurposeFilter}" Margin="0,0,0,14"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Clear" Style="{StaticResource SecondaryButton}" Command="{Binding ClearFiltersCommand}" Margin="0,0,8,0"/>
                <Button Content="Done" Style="{StaticResource PrimaryButton}" Command="{Binding ToggleFiltersCommand}"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>

      <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}"
              MinWidth="112" Padding="14,8" FontSize="13" Margin="0,0,8,0"
              Command="{Binding AddCommand}"
              IsEnabled="{Binding DataContext.CanAdd, RelativeSource={RelativeSource AncestorType=Window}}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#xE710;" Style="{StaticResource BtnIcon}" Foreground="White"/>
          <TextBlock Text="Add asset" Style="{StaticResource BtnLabel}" Foreground="White"/>
        </StackPanel>
      </Button>
      <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="0,0,8,0"
              Command="{Binding EditCommand}"
              IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#xE70F;" Style="{StaticResource BtnIcon}"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          <TextBlock Text="Edit" Style="{StaticResource BtnLabel}"/>
        </StackPanel>
      </Button>
      <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="0,0,8,0"
              Command="{Binding AssignCommand}"
              IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}"
              ToolTip="Assign or unassign the selected assets">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#xE716;" Style="{StaticResource BtnIcon}"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          <TextBlock Text="Assign" Style="{StaticResource BtnLabel}"/>
        </StackPanel>
      </Button>
      <Button DockPanel.Dock="Left" Style="{StaticResource DangerButton}" Padding="12,8" Margin="0,0,8,0"
              Command="{Binding DeleteCommand}"
              IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=Window}}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#xE74D;" Style="{StaticResource BtnIcon}"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          <TextBlock Text="Delete" Style="{StaticResource BtnLabel}"/>
        </StackPanel>
      </Button>
      <Grid DockPanel.Dock="Left" Margin="0,0,8,0">
        <Button Style="{StaticResource SecondaryButton}" Padding="12,8" Command="{Binding ToggleToolsCommand}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE90F;" Style="{StaticResource BtnIcon}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <TextBlock Text="Tools" Style="{StaticResource BtnLabel}"/>
          </StackPanel>
        </Button>
        <Popup IsOpen="{Binding ToolsOpen}" Placement="Bottom" HorizontalOffset="0"
               StaysOpen="False" AllowsTransparency="True">
          <Border Style="{StaticResource Card}" Width="280" Padding="6,8" Margin="0,8,0,0">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.16" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
              <TextBlock Text="File" Style="{StaticResource FieldLabel}" Margin="8,4,8,4"/>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding ImportCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE8B5;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Import from Excel / CSV" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding ImportManageEngineCommand}"
                      Visibility="{Binding ShowComputerTools, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE8F1;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Import ManageEngine…" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding ExportCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE74E;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Export to Excel" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding ExportViewCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE9F9;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Export current view (CSV)" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding TemplateCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE8A5;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Download import template" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding ResetColumnsCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE8A9;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Reset column order" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>

              <Separator Margin="8,8"/>
              <TextBlock Text="Bulk" Style="{StaticResource FieldLabel}" Margin="8,4,8,4"/>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding BulkEditCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE70F;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Bulk edit…" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding BulkAddCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE8FA;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Bulk add (paste list)…" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding BulkStatusCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE8CB;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Bulk status change" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding MarkConnectedTodayCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE787;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Mark connected today" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding RenumberByIpCommand}"
                      Visibility="{Binding ShowComputerTools, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE8EC;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Renumber Sr by IP order" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding FindDuplicatesCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE8C8;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Find duplicates" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding AddLocationCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE707;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Add custom location…" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>

              <Separator Margin="8,8"/>
              <TextBlock Text="Grid" Style="{StaticResource FieldLabel}" Margin="8,4,8,4"/>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding ToggleFreezeColumnsCommand}"
                      ToolTip="Keep Sr No through Serial on screen while scrolling right">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                             FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"
                             Foreground="{DynamicResource AccentBrush}"
                             Visibility="{Binding FreezeIdentityColumns, Converter={StaticResource BoolToVis}}"/>
                  <TextBlock DockPanel.Dock="Left" Text="&#xE718;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Freeze identity columns" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>
      <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Padding="12,8"
              Command="{Binding LoadCommand}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#xE72C;" Style="{StaticResource BtnIcon}"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          <TextBlock Text="Refresh" Style="{StaticResource BtnLabel}"/>
        </StackPanel>
      </Button>
    </DockPanel>

    <Grid Grid.Row="2">
      <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
        <DataGrid x:Name="AssetGrid"
                  ItemsSource="{Binding AssetsView}"
                  SelectedItem="{Binding Selected}"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  IsReadOnly="True"
                  SelectionChanged="OnSelectionChanged"
                  PreviewMouseRightButtonDown="OnRightDown"
                  BorderThickness="0"
                  FrozenColumnCount="{Binding FrozenColumnCount}"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="{Binding FreezeIdentityColumns, Converter={StaticResource InvertBool}}">
          <DataGrid.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem Header="Open" Command="{Binding OpenCommand}" InputGestureText="Enter">
                <MenuItem.Icon>
                  <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Edit" Command="{Binding EditCommand}" InputGestureText="F2">
                <MenuItem.Icon>
                  <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Assign…" Command="{Binding AssignCommand}">
                <MenuItem.Icon>
                  <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Unassign" Command="{Binding UnassignCommand}">
                <MenuItem.Icon>
                  <TextBlock Text="&#xE8F2;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Copy as new asset" Command="{Binding CopyAsNewCommand}">
                <MenuItem.Icon>
                  <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                </MenuItem.Icon>
              </MenuItem>
              <Separator/>
              <MenuItem Header="Delete" Command="{Binding DeleteCommand}" InputGestureText="Del">
                <MenuItem.Icon>
                  <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                </MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.InputBindings>
            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenCommand}"/>
            <KeyBinding Key="Return" Command="{Binding OpenCommand}"/>
            <KeyBinding Key="F2" Command="{Binding EditCommand}"/>
            <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
          </DataGrid.InputBindings>
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource PavDataGridRow}">
              <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
              <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasNotes}" Value="True">
                  <Setter Property="ToolTip">
                    <Setter.Value>
                      <ToolTip>
                        <StackPanel MaxWidth="340">
                          <TextBlock Text="Note" FontWeight="SemiBold" Margin="0,0,0,6"/>
                          <TextBlock Text="{Binding Remarks}" TextWrapping="Wrap"/>
                        </StackPanel>
                      </ToolTip>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="36" MinWidth="36" CanUserResize="False" CanUserReorder="False"
                                    SortMemberPath="HasNotes">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Ellipse Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Fill="{DynamicResource AccentBrush}"
                           ToolTip="{Binding Remarks}">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasNotes}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Sr No" Binding="{Binding SrNo}" Width="60"/>
            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="130"/>
            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90"/>
            <DataGridTextColumn Header="Make / Model" Binding="{Binding MakeModel}" Width="200"/>
            <DataGridTextColumn Header="Serial Number" Binding="{Binding SerialNumber}" Width="150"/>
            <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="140"
                                Visibility="{Binding DataContext.ShowComputerTools, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
            <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="110"
                                Visibility="{Binding DataContext.ShowComputerTools, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
            <DataGridTextColumn Header="User Name" Binding="{Binding AssignedUser}" Width="150"/>
            <DataGridTextColumn Header="Designation" Binding="{Binding Designation}" Width="140"/>
            <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="90"
                                Visibility="{Binding DataContext.ShowComputerTools, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
            <DataGridTemplateColumn Header="Status" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource StatusPill}"
                          Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="100"
                                Visibility="{Binding DataContext.ShowComputerTools, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
            <DataGridTextColumn Header="MAC Address" Binding="{Binding MacAddress}" Width="130"
                                Visibility="{Binding DataContext.ShowComputerTools, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
            <DataGridTextColumn Header="Processor" Binding="{Binding Processor}" Width="200"
                                Visibility="{Binding DataContext.ShowComputerTools, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
            <DataGridTextColumn Header="RAM" Binding="{Binding Ram}" Width="70"
                                Visibility="{Binding DataContext.ShowComputerTools, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
            <DataGridTextColumn Header="Storage" Binding="{Binding Storage}" Width="110"
                                Visibility="{Binding DataContext.ShowComputerTools, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
            <DataGridTextColumn Header="OS" Binding="{Binding OperatingSystem}" Width="180"
                                Visibility="{Binding DataContext.ShowComputerTools, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
            <DataGridTextColumn Header="DC" Binding="{Binding DcInstalled}" Width="50"
                                Visibility="{Binding DataContext.ShowComputerTools, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
            <DataGridTextColumn Header="AV" Binding="{Binding AvInstalled}" Width="50"
                                Visibility="{Binding DataContext.ShowComputerTools, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
            <DataGridTextColumn Header="Office" Binding="{Binding MsOfficeVersion}" Width="70"
                                Visibility="{Binding DataContext.ShowComputerTools, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
            <DataGridTextColumn Header="MFA" Binding="{Binding MfaEnabled}" Width="50"
                                Visibility="{Binding DataContext.ShowComputerTools, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
            <DataGridTextColumn Header="Ivanti" Binding="{Binding IvantiInstalled}" Width="60"
                                Visibility="{Binding DataContext.ShowComputerTools, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
            <DataGridTextColumn Header="Admin" Binding="{Binding AdminRights}" Width="60"
                                Visibility="{Binding DataContext.ShowComputerTools, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
            <DataGridTextColumn Header="USB" Binding="{Binding UsbAccess}" Width="50"
                                Visibility="{Binding DataContext.ShowComputerTools, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
            <DataGridTextColumn Header="Chrome" Binding="{Binding ChromeUpdated}" Width="70"
                                Visibility="{Binding DataContext.ShowComputerTools, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
            <DataGridTextColumn Header="PM" Binding="{Binding PmCompleted}" Width="50"
                                Visibility="{Binding DataContext.ShowComputerTools, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
            <DataGridTextColumn Header="Last Connected" Binding="{Binding LastConnected, StringFormat=yyyy-MM-dd}" Width="110"
                                Visibility="{Binding DataContext.ShowComputerTools, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
            <DataGridTextColumn Header="Collect By" Binding="{Binding CollectBy}" Width="120"/>
            <DataGridTextColumn Header="Alternate User" Binding="{Binding AlternateUser}" Width="140"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <TextBlock Text="{Binding EmptyText}" FontSize="14" Foreground="{DynamicResource MutedBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"
                 Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}"/>

      <Border Background="{DynamicResource OverlayBrush}" Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="Loading…" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="14,10" Margin="0,12,0,0"
            Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Undo" Command="{Binding UndoDeleteCommand}"
                Padding="16,6" FontWeight="SemiBold" Cursor="Hand" Margin="12,0,0,0">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border Background="White" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <TextBlock Text="{Binding UndoLabel}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                   VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
