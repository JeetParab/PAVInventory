<UserControl x:Class="PAV.Client.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <UserControl.InputBindings>
    <KeyBinding Gesture="Ctrl+F" Command="{Binding FocusSearchCommand}"/>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding AddCommand}"/>
    <KeyBinding Key="F5" Command="{Binding LoadCommand}"/>
  </UserControl.InputBindings>
  <Grid Margin="0,0,4,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}"/>
        <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0">
          <Run Text="{Binding Assets.Count, Mode=OneWay}"/><Run Text=" assets  ·  "/><Run Text="{Binding PageHint, Mode=OneWay}"/>
        </TextBlock>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0"
                   Visibility="{Binding HasFilters, Converter={StaticResource BoolToVis}}">
          <Run Text="Showing "/><Run Text="{Binding VisibleCount, Mode=OneWay}"/><Run Text=" of "/><Run Text="{Binding Assets.Count, Mode=OneWay}"/>
        </TextBlock>
        <Border CornerRadius="9" Padding="9,2" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedCount}" Value="0">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">
            <Run Text="{Binding SelectedCount, Mode=OneWay}"/><Run Text=" selected"/>
          </TextBlock>
        </Border>
        <Button Content="Clear filters" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                Command="{Binding ClearFiltersCommand}" Padding="10,4" FontSize="12"
                Visibility="{Binding HasFilters, Converter={StaticResource BoolToVis}}"/>
        <ToggleButton x:Name="DetailsToggle" Style="{StaticResource PanelToggle}" Margin="8,0,0,0"
                      ToolTip="Show or hide the asset details panel">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE8A1;" Style="{StaticResource BtnIcon}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
            <TextBlock Text="Details" Style="{StaticResource BtnLabel}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
          </StackPanel>
        </ToggleButton>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="200" MaxWidth="460"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid Margin="0,0,12,0">
        <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBox}"
                 Tag="Search serial number, hostname, user, IP address…"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Search tag, serial, hostname, IP, user, location, category, status, model…"/>
        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14"
                   Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"
                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </Grid>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Grid Margin="0,0,8,0">
        <Button Padding="12,8" Command="{Binding ToggleFiltersCommand}">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveFilterCount, Converter={StaticResource Eq}, ConverterParameter=0}" Value="False">
                  <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                  <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                  <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE71C;" Style="{StaticResource BtnIcon}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <TextBlock Text="Filters" Style="{StaticResource BtnLabel}"/>
            <TextBlock Margin="6,0,0,0" FontWeight="SemiBold">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource BtnLabel}">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ActiveFilterCount}" Value="0">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
              <Run Text="{Binding ActiveFilterCount, Mode=OneWay}"/><Run Text=" active"/>
            </TextBlock>
          </StackPanel>
        </Button>
        <Popup IsOpen="{Binding FiltersOpen}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
          <Border Style="{StaticResource Card}" Width="300" Margin="0,8,0,0" Padding="16">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.16" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
              <TextBlock Text="Filters" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
              <TextBlock Text="Optional. Leave on All to show every asset." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
              <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding StatusChoices}" SelectedItem="{Binding StatusFilter}" Margin="0,0,0,10"/>
              <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding Categories}" SelectedValuePath="Id"
                        SelectedValue="{Binding CategoryFilter}" Margin="0,0,0,10">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="Location" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding Locations}" SelectedValuePath="Id"
                        SelectedValue="{Binding LocationFilter}" Margin="0,0,0,10">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="Manufacturer" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding Manufacturers}" SelectedItem="{Binding ManufacturerFilter}" Margin="0,0,0,10"/>
              <TextBlock Text="Assignment" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding AssignedChoices}" SelectedItem="{Binding AssignedFilter}" Margin="0,0,0,10"/>
              <StackPanel Visibility="{Binding ShowComputerTools, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Purpose" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding PurposeChoices}" SelectedItem="{Binding PurposeFilter}" Margin="0,0,0,14"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Clear" Style="{StaticResource SecondaryButton}" Command="{Binding ClearFiltersCommand}" Margin="0,0,8,0"/>
                <Button Content="Done" Style="{StaticResource PrimaryButton}" Command="{Binding ToggleFiltersCommand}"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>

      <Border Style="{StaticResource ToolbarDivider}" Margin="0,6,10,6"/>
      <Button Style="{StaticResource PrimaryButton}"
              MinWidth="108" Padding="14,8" FontSize="13" Margin="0,0,10,0"
              Command="{Binding AddCommand}"
              IsEnabled="{Binding DataContext.CanAdd, RelativeSource={RelativeSource AncestorType=Window}}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#xE710;" Style="{StaticResource BtnIcon}" Foreground="White"/>
          <TextBlock Text="Add asset" Style="{StaticResource BtnLabel}" Foreground="White"/>
        </StackPanel>
      </Button>
      <Button Style="{StaticResource SecondaryButton}" Padding="10,8" Margin="0,0,6,0"
              Command="{Binding EditCommand}"
              ToolTip="Edit the selected asset (F2)">
        <Button.IsEnabled>
          <MultiBinding Converter="{StaticResource EnabledWhenSelected}">
            <Binding Path="DataContext.CanEdit" RelativeSource="{RelativeSource AncestorType=Window}"/>
            <Binding Path="SelectedCount"/>
          </MultiBinding>
        </Button.IsEnabled>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#xE70F;" Style="{StaticResource BtnIcon}"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          <TextBlock Text="Edit" Style="{StaticResource BtnLabel}"/>
        </StackPanel>
      </Button>
      <Button Style="{StaticResource SecondaryButton}" Padding="10,8" Margin="0,0,6,0"
              Command="{Binding AssignCommand}"
              ToolTip="Assign or unassign the selected assets">
        <Button.IsEnabled>
          <MultiBinding Converter="{StaticResource EnabledWhenSelected}">
            <Binding Path="DataContext.CanEdit" RelativeSource="{RelativeSource AncestorType=Window}"/>
            <Binding Path="SelectedCount"/>
          </MultiBinding>
        </Button.IsEnabled>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#xE716;" Style="{StaticResource BtnIcon}"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          <TextBlock Text="Assign" Style="{StaticResource BtnLabel}"/>
        </StackPanel>
      </Button>
      <Button Style="{StaticResource DangerButton}" Padding="10,8" Margin="0,0,0,0"
              Command="{Binding DeleteCommand}"
              ToolTip="Delete the selected asset (Del)">
        <Button.IsEnabled>
          <MultiBinding Converter="{StaticResource EnabledWhenSelected}">
            <Binding Path="DataContext.CanDelete" RelativeSource="{RelativeSource AncestorType=Window}"/>
            <Binding Path="SelectedCount"/>
          </MultiBinding>
        </Button.IsEnabled>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#xE74D;" Style="{StaticResource BtnIcon}"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          <TextBlock Text="Delete" Style="{StaticResource BtnLabel}"/>
        </StackPanel>
      </Button>
      <Border Style="{StaticResource ToolbarDivider}" Margin="10,6,10,6"/>
      <Grid Margin="0,0,6,0">
        <Button Style="{StaticResource SecondaryButton}" Padding="10,8" Command="{Binding ToggleToolsCommand}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE90F;" Style="{StaticResource BtnIcon}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <TextBlock Text="Tools" Style="{StaticResource BtnLabel}"/>
          </StackPanel>
        </Button>
        <Popup IsOpen="{Binding ToolsOpen}" Placement="Bottom" HorizontalOffset="0"
               StaysOpen="False" AllowsTransparency="True">
          <Border Style="{StaticResource Card}" Width="280" Padding="6,8" Margin="0,8,0,0">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.16" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
              <TextBlock Text="File" Style="{StaticResource FieldLabel}" Margin="8,4,8,4"/>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding ImportCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE8B5;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Import from Excel / CSV" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding ImportManageEngineCommand}"
                      Visibility="{Binding ShowComputerTools, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE8F1;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Import ManageEngine…" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding ExportCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE74E;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Export to Excel" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding ExportViewCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE9F9;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Export current view (CSV)" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding TemplateCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE8A5;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Download import template" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding ResetColumnsCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE8A9;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Reset column order" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>

              <Separator Margin="8,8"/>
              <TextBlock Text="Bulk" Style="{StaticResource FieldLabel}" Margin="8,4,8,4"/>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding BulkEditCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE70F;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Bulk edit…" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding BulkAddCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE8FA;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Bulk add (paste list)…" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding BulkStatusCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE8CB;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Bulk status change" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding MarkConnectedTodayCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE787;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Mark connected today" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding RenumberByIpCommand}"
                      Visibility="{Binding ShowComputerTools, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE8EC;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Renumber Sr by IP order" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding FindDuplicatesCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE8C8;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Find duplicates" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding AddLocationCommand}">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE707;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Add custom location…" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>

              <Separator Margin="8,8"/>
              <TextBlock Text="Grid" Style="{StaticResource FieldLabel}" Margin="8,4,8,4"/>
              <Button Style="{StaticResource ToolMenuButton}" Command="{Binding ToggleFreezeColumnsCommand}"
                      ToolTip="Keep Sr No through Serial on screen while scrolling right">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                             FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"
                             Foreground="{DynamicResource AccentBrush}"
                             Visibility="{Binding FreezeIdentityColumns, Converter={StaticResource BoolToVis}}"/>
                  <TextBlock DockPanel.Dock="Left" Text="&#xE718;" Style="{StaticResource MenuIcon}"/>
                  <TextBlock Text="Freeze identity columns" VerticalAlignment="Center"/>
                </DockPanel>
              </Button>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>
      <Button Style="{StaticResource SecondaryButton}" Padding="10,8"
              Command="{Binding LoadCommand}" ToolTip="Refresh (F5)">
        <TextBlock Text="&#xE72C;" Style="{StaticResource BtnIcon}" Margin="0"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
      <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
        <DataGrid x:Name="AssetGrid"
                  ItemsSource="{Binding AssetsView}"
                  SelectedItem="{Binding Selected}"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  IsReadOnly="True"
                  SelectionChanged="OnSelectionChanged"
                  PreviewMouseRightButtonDown="OnRightDown"
                  BorderThickness="0"
                  FrozenColumnCount="0"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="False">
          <DataGrid.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem Header="Open" Command="{Binding OpenCommand}" InputGestureText="Enter">
                <MenuItem.Icon>
                  <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Edit" Command="{Binding EditCommand}" InputGestureText="F2">
                <MenuItem.Icon>
                  <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Assign…" Command="{Binding AssignCommand}">
                <MenuItem.Icon>
                  <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Unassign" Command="{Binding UnassignCommand}">
                <MenuItem.Icon>
                  <TextBlock Text="&#xE8F2;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Copy as new asset" Command="{Binding CopyAsNewCommand}">
                <MenuItem.Icon>
                  <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                </MenuItem.Icon>
              </MenuItem>
              <Separator/>
              <MenuItem Header="Delete" Command="{Binding DeleteCommand}" InputGestureText="Del">
                <MenuItem.Icon>
                  <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                </MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.InputBindings>
            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenCommand}"/>
            <KeyBinding Key="Return" Command="{Binding OpenCommand}"/>
            <KeyBinding Key="F2" Command="{Binding EditCommand}"/>
            <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
          </DataGrid.InputBindings>
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource PavDataGridRow}">
              <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
              <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasNotes}" Value="True">
                  <Setter Property="ToolTip">
                    <Setter.Value>
                      <ToolTip>
                        <StackPanel MaxWidth="340">
                          <TextBlock Text="Note" FontWeight="SemiBold" Margin="0,0,0,6"/>
                          <TextBlock Text="{Binding Remarks}" TextWrapping="Wrap"/>
                        </StackPanel>
                      </ToolTip>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="36" MinWidth="36" CanUserResize="False" CanUserReorder="False"
                                    SortMemberPath="HasNotes">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid>
                    <Border Width="3" Height="34" Margin="-10,0,0,0" HorizontalAlignment="Left"
                            Background="{DynamicResource AccentBrush}">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                    </Border>
                    <Ellipse Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Fill="{DynamicResource AccentBrush}"
                             ToolTip="{Binding Remarks}">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNotes}" Value="True">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Sr No" Binding="{Binding SrNo}" Width="56"/>
            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="120"/>
            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="84"/>
            <DataGridTextColumn Header="Make / Model" Binding="{Binding MakeModel}" Width="190"/>
            <DataGridTextColumn Header="Serial Number" Binding="{Binding SerialNumber}" Width="140"/>
            <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="130"/>
            <DataGridTextColumn Header="User Name" Binding="{Binding AssignedUser}" Width="150"/>
            <DataGridTemplateColumn Header="Status" Width="112">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource StatusPill}" Padding="7,2,9,2"
                          Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                               Fill="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"/>
                      <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="110"/>
            <DataGridTextColumn Header="Designation" Binding="{Binding Designation}" Width="140"/>
            <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="90"/>
            <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="100"/>
            <DataGridTextColumn Header="MAC Address" Binding="{Binding MacAddress}" Width="130"/>
            <DataGridTextColumn Header="Processor" Binding="{Binding Processor}" Width="200"/>
            <DataGridTextColumn Header="RAM" Binding="{Binding Ram}" Width="70"/>
            <DataGridTextColumn Header="Storage" Binding="{Binding Storage}" Width="110"/>
            <DataGridTextColumn Header="OS" Binding="{Binding OperatingSystem}" Width="180"/>
            <DataGridTextColumn Header="DC" Binding="{Binding DcInstalled}" Width="50"/>
            <DataGridTextColumn Header="AV" Binding="{Binding AvInstalled}" Width="50"/>
            <DataGridTextColumn Header="Office" Binding="{Binding MsOfficeVersion}" Width="70"/>
            <DataGridTextColumn Header="MFA" Binding="{Binding MfaEnabled}" Width="50"/>
            <DataGridTextColumn Header="Ivanti" Binding="{Binding IvantiInstalled}" Width="60"/>
            <DataGridTextColumn Header="Admin" Binding="{Binding AdminRights}" Width="60"/>
            <DataGridTextColumn Header="USB" Binding="{Binding UsbAccess}" Width="50"/>
            <DataGridTextColumn Header="Chrome" Binding="{Binding ChromeUpdated}" Width="70"/>
            <DataGridTextColumn Header="PM" Binding="{Binding PmCompleted}" Width="50"/>
            <DataGridTextColumn Header="Last Connected" Binding="{Binding LastConnected, StringFormat=yyyy-MM-dd}" Width="110"/>
            <DataGridTextColumn Header="Collect By" Binding="{Binding CollectBy}" Width="120"/>
            <DataGridTextColumn Header="Alternate User" Binding="{Binding AlternateUser}" Width="140"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <TextBlock Text="{Binding EmptyText}" FontSize="14" Foreground="{DynamicResource MutedBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"
                 Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}"/>

      <Border Background="{DynamicResource OverlayBrush}" Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="Loading…" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
      </Border>
      </Grid>

      <!-- Selected asset details (read-only; bound to the existing Selected row) -->
      <Border Grid.Column="1" Style="{StaticResource Card}" Width="276" Margin="12,0,0,0" Padding="0"
              Visibility="{Binding IsChecked, ElementName=DetailsToggle, Converter={StaticResource BoolToVis}}">
        <Grid>
          <!-- No selection -->
          <TextBlock Text="Select an asset to see its details." TextAlignment="Center" TextWrapping="Wrap"
                     VerticalAlignment="Center" Margin="24,0" FontSize="12"
                     Foreground="{DynamicResource MutedBrush}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedCount}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <!-- Several rows selected -->
          <TextBlock TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="24,0"
                     FontSize="12" Foreground="{DynamicResource MutedBrush}">
            <Run Text="{Binding SelectedCount, Mode=OneWay}"/><Run Text=" assets selected."/>
            <LineBreak/>
            <Run Text="Use Assign, Edit or the Tools menu to act on all of them, or select a single row to see its details."/>
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedCount}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding SelectedCount}" Value="1">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <!-- Exactly one row selected -->
          <DockPanel>
            <DockPanel.Style>
              <Style TargetType="DockPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedCount}" Value="1">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DockPanel.Style>

            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,10">
              <Button Content="Open full details" Style="{StaticResource SecondaryButton}"
                      Command="{Binding OpenCommand}" Padding="10,7" HorizontalAlignment="Stretch"/>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
              <StackPanel DataContext="{Binding Selected}" Margin="16,14,16,6">
                <TextBlock Text="ASSET DETAILS" Style="{StaticResource DetailSection}" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding MakeModel}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding AssetTag}" Style="{StaticResource MutedText}" Margin="0,2,0,8"/>
                <Border Style="{StaticResource StatusPill}" Padding="7,2,9,2" Margin="0,0,0,14"
                        Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                             Fill="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"/>
                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"/>
                  </StackPanel>
                </Border>

                <TextBlock Text="IDENTITY" Style="{StaticResource DetailSection}"/>
                <TextBlock Text="Category" Style="{StaticResource DetailLabel}"/>
                <TextBlock Text="{Binding Category}" Style="{StaticResource DetailValue}"/>
                <TextBlock Text="Serial Number" Style="{StaticResource DetailLabel}"/>
                <TextBlock Text="{Binding SerialNumber}" Style="{StaticResource DetailValue}"/>
                <TextBlock Text="Hostname" Style="{StaticResource DetailLabel}"/>
                <TextBlock Text="{Binding Hostname}" Style="{StaticResource DetailValue}"/>
                <TextBlock Text="Location" Style="{StaticResource DetailLabel}"/>
                <TextBlock Text="{Binding Location}" Style="{StaticResource DetailValue}"/>
                <TextBlock Text="Purpose" Style="{StaticResource DetailLabel}"/>
                <TextBlock Text="{Binding Purpose}" Style="{StaticResource DetailValue}"/>

                <TextBlock Text="ASSIGNMENT" Style="{StaticResource DetailSection}" Margin="0,6,0,8"/>
                <TextBlock Text="Assigned User" Style="{StaticResource DetailLabel}"/>
                <TextBlock Text="{Binding AssignedUser}" Style="{StaticResource DetailValue}"/>
                <TextBlock Text="Designation" Style="{StaticResource DetailLabel}"/>
                <TextBlock Text="{Binding Designation}" Style="{StaticResource DetailValue}"/>
                <TextBlock Text="Alternate User" Style="{StaticResource DetailLabel}"/>
                <TextBlock Text="{Binding AlternateUser}" Style="{StaticResource DetailValue}"/>

                <TextBlock Text="NETWORK" Style="{StaticResource DetailSection}" Margin="0,6,0,8"/>
                <TextBlock Text="IP Address" Style="{StaticResource DetailLabel}"/>
                <TextBlock Text="{Binding IpAddress}" Style="{StaticResource DetailValue}"/>
                <TextBlock Text="MAC Address" Style="{StaticResource DetailLabel}"/>
                <TextBlock Text="{Binding MacAddress}" Style="{StaticResource DetailValue}"/>
                <TextBlock Text="Domain" Style="{StaticResource DetailLabel}"/>
                <TextBlock Text="{Binding Domain}" Style="{StaticResource DetailValue}"/>

                <StackPanel Visibility="{Binding DataContext.ShowComputerTools, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="HARDWARE" Style="{StaticResource DetailSection}" Margin="0,6,0,8"/>
                  <TextBlock Text="Processor" Style="{StaticResource DetailLabel}"/>
                  <TextBlock Text="{Binding Processor}" Style="{StaticResource DetailValue}"/>
                  <TextBlock Text="RAM  ·  Storage" Style="{StaticResource DetailLabel}"/>
                  <TextBlock Style="{StaticResource DetailValue}">
                    <Run Text="{Binding Ram, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Storage, Mode=OneWay}"/>
                  </TextBlock>
                  <TextBlock Text="Operating System" Style="{StaticResource DetailLabel}"/>
                  <TextBlock Text="{Binding OperatingSystem}" Style="{StaticResource DetailValue}"/>

                  <TextBlock Text="COMPLIANCE" Style="{StaticResource DetailSection}" Margin="0,6,0,8"/>
                  <UniformGrid Columns="3" Margin="0,0,0,4">
                    <StackPanel><TextBlock Text="DC" Style="{StaticResource DetailLabel}"/><TextBlock Text="{Binding DcInstalled}" Style="{StaticResource DetailValue}"/></StackPanel>
                    <StackPanel><TextBlock Text="AV" Style="{StaticResource DetailLabel}"/><TextBlock Text="{Binding AvInstalled}" Style="{StaticResource DetailValue}"/></StackPanel>
                    <StackPanel><TextBlock Text="Office" Style="{StaticResource DetailLabel}"/><TextBlock Text="{Binding MsOfficeVersion}" Style="{StaticResource DetailValue}"/></StackPanel>
                    <StackPanel><TextBlock Text="MFA" Style="{StaticResource DetailLabel}"/><TextBlock Text="{Binding MfaEnabled}" Style="{StaticResource DetailValue}"/></StackPanel>
                    <StackPanel><TextBlock Text="Ivanti" Style="{StaticResource DetailLabel}"/><TextBlock Text="{Binding IvantiInstalled}" Style="{StaticResource DetailValue}"/></StackPanel>
                    <StackPanel><TextBlock Text="Admin" Style="{StaticResource DetailLabel}"/><TextBlock Text="{Binding AdminRights}" Style="{StaticResource DetailValue}"/></StackPanel>
                    <StackPanel><TextBlock Text="USB" Style="{StaticResource DetailLabel}"/><TextBlock Text="{Binding UsbAccess}" Style="{StaticResource DetailValue}"/></StackPanel>
                    <StackPanel><TextBlock Text="Chrome" Style="{StaticResource DetailLabel}"/><TextBlock Text="{Binding ChromeUpdated}" Style="{StaticResource DetailValue}"/></StackPanel>
                    <StackPanel><TextBlock Text="PM" Style="{StaticResource DetailLabel}"/><TextBlock Text="{Binding PmCompleted}" Style="{StaticResource DetailValue}"/></StackPanel>
                  </UniformGrid>
                  <TextBlock Text="Last Connected" Style="{StaticResource DetailLabel}"/>
                  <TextBlock Text="{Binding LastConnected, StringFormat=yyyy-MM-dd}" Style="{StaticResource DetailValue}"/>
                  <TextBlock Text="Collect By" Style="{StaticResource DetailLabel}"/>
                  <TextBlock Text="{Binding CollectBy}" Style="{StaticResource DetailValue}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="NOTES" Style="{StaticResource DetailSection}" Margin="0,6,0,8"/>
                  <TextBlock Text="{Binding Remarks}" Style="{StaticResource DetailValue}"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="14,10" Margin="0,12,0,0"
            Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Undo" Command="{Binding UndoDeleteCommand}"
                Padding="16,6" FontWeight="SemiBold" Cursor="Hand" Margin="12,0,0,0">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border Background="White" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <TextBlock Text="{Binding UndoLabel}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                   VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
