<Window x:Class="PAV.Client.Views.StockImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stock import preview" Width="860" Height="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">
  <DockPanel Margin="22">
    <TextBlock DockPanel.Dock="Top" Text="Stock import preview" Style="{StaticResource PageTitle}" Margin="0,0,0,6"/>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Preview.Summary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Preview.SourceKind}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"
               TextWrapping="Wrap" Margin="0,0,0,8"/>
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Preview.Issues}" Margin="0,0,0,10">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,4"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"
              Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Import" Style="{StaticResource PrimaryButton}" Command="{Binding ImportCommand}"
              IsEnabled="{Binding Preview.CanImport}" IsDefault="True"/>
    </StackPanel>
    <Border Style="{StaticResource Card}" Padding="0">
      <DataGrid ItemsSource="{Binding Preview.Lines}" EnableColumnVirtualization="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*"/>
          <DataGridTextColumn Header="Make" Binding="{Binding Manufacturer}" Width="90"/>
          <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="100"/>
          <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90"/>
          <DataGridTextColumn Header="Open" Binding="{Binding OpeningQty}" Width="55"/>
          <DataGridTextColumn Header="Issued" Binding="{Binding IssuedQty}" Width="60"/>
          <DataGridTextColumn Header="Class" Binding="{Binding Classification}" Width="90"/>
          <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="100"/>
          <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="220"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</Window>
