<Window x:Class="PAV.Client.Views.IpAssignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize" Background="{DynamicResource BgBrush}">
  <DockPanel Margin="22">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,6"/>
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"
               Text="Type any address in the Floor 1–7 pool (172.16.101–107). Next-free is only a suggestion — you can change it."/>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"
               TextWrapping="Wrap" Margin="0,0,0,8"
               Visibility="{Binding Error, Converter={StaticResource StringToVis}}"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"
              Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Assign" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"
              IsDefault="True" IsEnabled="{Binding CanSave}"/>
    </StackPanel>
    <StackPanel>
      <TextBlock Text="IP address" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="AddressBox" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
               FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <TextBlock Text="{Binding AddressStatus}" TextWrapping="Wrap" Margin="0,0,0,12"
                 Foreground="{Binding AddressStatusBrush}"/>
      <TextBlock Text="Assigned user" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding AssignedUser, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
      <TextBlock Text="Assigned device / hostname" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding AssignedDevice, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
      <TextBlock Text="Department" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Device type" Style="{StaticResource FieldLabel}"/>
          <ComboBox ItemsSource="{Binding DeviceTypes}" Text="{Binding DeviceType, UpdateSourceTrigger=PropertyChanged}"
                    IsEditable="True"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="MAC address" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding MacAddress, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
      </Grid>
      <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="64"
               TextWrapping="Wrap" AcceptsReturn="True"/>
    </StackPanel>
  </DockPanel>
</Window>
