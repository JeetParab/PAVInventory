<Window x:Class="PAV.Client.Views.DuplicatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find duplicates" Width="680" Height="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" Text="Duplicate serial numbers" Style="{StaticResource PageTitle}" Margin="0,0,0,8"/>
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"
               Text="Pick the row to keep in each group, then remove extras."/>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,8"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Close" Style="{StaticResource SecondaryButton}" Command="{Binding CloseCommand}" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Remove extras" Style="{StaticResource DangerButton}" Command="{Binding RemoveExtrasCommand}"/>
    </StackPanel>
    <ListBox ItemsSource="{Binding Groups}" BorderThickness="0" HorizontalContentAlignment="Stretch">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Margin="0,0,0,6">
                <Run Text="Serial  "/><Run Text="{Binding Group.SerialNumber, Mode=OneWay}"/>
                <Run Text="  ·  "/><Run Text="{Binding Group.Assets.Count, Mode=OneWay}"/><Run Text=" copies"/>
              </TextBlock>
              <TextBlock Text="Keep" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding Group.Assets}" SelectedValuePath="Id"
                        SelectedValue="{Binding KeepId}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DupLabel}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
