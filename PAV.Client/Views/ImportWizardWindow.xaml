<Window x:Class="PAV.Client.Views.ImportWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import from Excel or CSV"
        Width="720" Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" Text="{Binding StepTitle}" Style="{StaticResource PageTitle}" Margin="0,0,0,6"/>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"
               TextWrapping="Wrap" Margin="0,0,0,10"/>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Back" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" Margin="0,0,8,0"/>
      <Button Content="Next" Command="{Binding NextCommand}" Margin="0,0,8,0">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Step}" Value="3">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Step}" Value="4">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button Content="Import" Command="{Binding ImportCommand}" Margin="0,0,8,0">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Step}" Value="3">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button Content="Close" Style="{StaticResource SecondaryButton}" Command="{Binding CloseCommand}" IsCancel="True"/>
    </StackPanel>

    <Grid>
      <StackPanel VerticalAlignment="Top">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Step}" Value="1">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock Text="Select an .xlsx file. Microsoft Excel does not need to be installed."
                   Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource PrimaryButton}"
                  Command="{Binding BrowseCommand}" Margin="8,0,0,0"/>
          <TextBox Text="{Binding FileName}" IsReadOnly="True"/>
        </DockPanel>
      </StackPanel>

      <ScrollViewer>
        <ScrollViewer.Style>
          <Style TargetType="ScrollViewer">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Step}" Value="2">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ScrollViewer.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Asset ID *" VerticalAlignment="Center" Margin="0,0,0,8"/>
          <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Columns}" SelectedItem="{Binding ColAssetTag}" Margin="0,0,0,8"/>
          <TextBlock Grid.Row="1" Text="Category *" VerticalAlignment="Center" Margin="0,0,0,8"/>
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Columns}" SelectedItem="{Binding ColCategory}" Margin="0,0,0,8"/>
          <TextBlock Grid.Row="2" Text="Manufacturer" VerticalAlignment="Center" Margin="0,0,0,8"/>
          <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Columns}" SelectedItem="{Binding ColManufacturer}" Margin="0,0,0,8"/>
          <TextBlock Grid.Row="3" Text="Model" VerticalAlignment="Center" Margin="0,0,0,8"/>
          <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Columns}" SelectedItem="{Binding ColModel}" Margin="0,0,0,8"/>
          <TextBlock Grid.Row="4" Text="Serial Number" VerticalAlignment="Center" Margin="0,0,0,8"/>
          <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Columns}" SelectedItem="{Binding ColSerial}" Margin="0,0,0,8"/>
          <TextBlock Grid.Row="5" Text="Hostname" VerticalAlignment="Center" Margin="0,0,0,8"/>
          <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Columns}" SelectedItem="{Binding ColHostname}" Margin="0,0,0,8"/>
          <TextBlock Grid.Row="6" Text="Location" VerticalAlignment="Center" Margin="0,0,0,8"/>
          <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding Columns}" SelectedItem="{Binding ColLocation}" Margin="0,0,0,8"/>
          <TextBlock Grid.Row="7" Text="Status *" VerticalAlignment="Center" Margin="0,0,0,8"/>
          <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding Columns}" SelectedItem="{Binding ColStatus}" Margin="0,0,0,8"/>
          <TextBlock Grid.Row="8" Text="Assigned User" VerticalAlignment="Center" Margin="0,0,0,8"/>
          <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding Columns}" SelectedItem="{Binding ColAssigned}" Margin="0,0,0,8"/>
          <TextBlock Grid.Row="9" Text="Purchase Date" VerticalAlignment="Center" Margin="0,0,0,8"/>
          <ComboBox Grid.Row="9" Grid.Column="1" ItemsSource="{Binding Columns}" SelectedItem="{Binding ColPurchase}" Margin="0,0,0,8"/>
          <TextBlock Grid.Row="10" Text="Warranty Expiry" VerticalAlignment="Center" Margin="0,0,0,8"/>
          <ComboBox Grid.Row="10" Grid.Column="1" ItemsSource="{Binding Columns}" SelectedItem="{Binding ColWarranty}" Margin="0,0,0,8"/>
          <TextBlock Grid.Row="11" Text="Remarks" VerticalAlignment="Center" Margin="0,0,0,8"/>
          <ComboBox Grid.Row="11" Grid.Column="1" ItemsSource="{Binding Columns}" SelectedItem="{Binding ColRemarks}" Margin="0,0,0,8"/>
        </Grid>
      </ScrollViewer>

      <DockPanel>
        <DockPanel.Style>
          <Style TargetType="DockPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Step}" Value="3">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DockPanel.Style>
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="{Binding PreviewSummary}"/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <CheckBox DockPanel.Dock="Left" Content="Show errors only" IsChecked="{Binding ErrorsOnly}" VerticalAlignment="Center"/>
          <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center">
            <Run Text="{Binding Preview.ValidCount, Mode=OneWay}"/>
            <Run Text=" valid · "/>
            <Run Text="{Binding Preview.ErrorCount, Mode=OneWay}"/>
            <Run Text=" blocked"/>
          </TextBlock>
        </DockPanel>
        <DataGrid ItemsSource="{Binding VisibleRows}" AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Row" Binding="{Binding RowNumber}" Width="50"/>
            <DataGridTextColumn Header="Valid" Binding="{Binding IsValid}" Width="60"/>
            <DataGridTextColumn Header="Errors" Binding="{Binding ErrorText}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Step}" Value="4">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock Text="Import complete" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource MutedText}">
          <Run Text="{Binding Result.Imported, Mode=OneWay}"/>
          <Run Text=" assets imported."/>
        </TextBlock>
      </StackPanel>

      <Border Background="#88FFFFFF" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="Working…" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
      </Border>
    </Grid>
  </DockPanel>
</Window>
