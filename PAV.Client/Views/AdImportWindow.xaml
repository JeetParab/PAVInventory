<Window x:Class="PAV.Client.Views.AdImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AD users — one-time import" Width="980" Height="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">
  <DockPanel Margin="22">
    <TextBlock DockPanel.Dock="Top" Text="Import AD user ids" Style="{StaticResource PageTitle}" Margin="0,0,0,6"/>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Preview.Summary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"
               TextWrapping="Wrap" Margin="0,0,0,8"/>
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Preview.Issues}" Margin="0,0,0,10">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,4"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"
              Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Apply" Style="{StaticResource PrimaryButton}" Command="{Binding ImportCommand}"
              IsEnabled="{Binding Preview.CanImport}" IsDefault="True"/>
    </StackPanel>
    <Border Style="{StaticResource Card}" Padding="0">
      <DataGrid ItemsSource="{Binding Preview.Lines}" EnableRowVirtualization="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="70"/>
          <DataGridTextColumn Header="User id" Binding="{Binding Sam}" Width="140"/>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
          <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
          <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="140"/>
          <DataGridTextColumn Header="Employee ID" Binding="{Binding EmployeeId}" Width="110"/>
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
          <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</Window>
