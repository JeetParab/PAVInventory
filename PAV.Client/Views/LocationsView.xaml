<UserControl x:Class="PAV.Client.Views.LocationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Locations" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="320"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="0">
        <DataGrid ItemsSource="{Binding Locations}" SelectedItem="{Binding Selected}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <Border Style="{StaticResource Card}" Grid.Column="2">
        <StackPanel>
          <TextBlock Text="Location" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"
                   IsEnabled="{Binding CanManage}"/>
          <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="80"
                   TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12"
                   IsEnabled="{Binding CanManage}"/>
          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,8"
                     TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="New" Style="{StaticResource SecondaryButton}" Command="{Binding NewItemCommand}" Margin="0,0,8,0"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"
                    IsEnabled="{Binding CanManage}" Margin="0,0,8,0"/>
            <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}"
                    IsEnabled="{Binding CanManage}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
