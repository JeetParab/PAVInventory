<UserControl x:Class="PAV.Client.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:PAV.Client.Services"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,16"/>
    <ScrollViewer x:Name="RootScroll"
                  svc:PageScroll.Smooth="True"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly"
                  IsDeferredScrollingEnabled="False">
      <!-- Bitmap cache: scrolling moves a cached visual instead of re-layouting every card/DataGrid -->
      <StackPanel>
        <StackPanel.CacheMode>
          <BitmapCache EnableClearType="True" RenderAtScale="1" SnapsToDevicePixels="True"/>
        </StackPanel.CacheMode>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Connection" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock Text="Signed in as" Style="{StaticResource FieldLabel}"/>
            <TextBlock Margin="0,0,0,10">
              <Run Text="{Binding SignedInName, Mode=OneWay}"/>
              <Run Text="  ·  "/>
              <Run Text="{Binding SignedInRole, Mode=OneWay}"/>
            </TextBlock>
            <Button Content="Sign out" Style="{StaticResource SecondaryButton}" Command="{Binding SignOutCommand}"
                    HorizontalAlignment="Left" Margin="0,0,0,12"/>
            <TextBlock Text="Shared folder" Style="{StaticResource FieldLabel}"/>
            <DockPanel Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource PrimaryButton}"
                      Command="{Binding SaveServerCommand}" Margin="8,0,0,0"
                      IsEnabled="{Binding CanManageDatabase}"/>
              <Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SecondaryButton}"
                      Command="{Binding BrowseDatabaseCommand}" Margin="8,0,0,0"
                      IsEnabled="{Binding CanManageDatabase}"/>
              <TextBox Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}"
                       IsEnabled="{Binding CanManageDatabase}"/>
            </DockPanel>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                       Text="Everyone must point at the same shared folder. The database file is inventory.db inside that folder."/>
            <TextBlock Text="{Binding ServerMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVis}}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Text="Sign-in accounts" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="+ Add engineer / admin" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddAccountCommand}" Margin="0,0,8,0" Padding="12,6"/>
                <Button Content="Edit" Style="{StaticResource SecondaryButton}"
                        Command="{Binding EditAccountCommand}" Padding="12,6"/>
              </StackPanel>
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="People who open PAV: username, password and role. Office staff you assign assets to live on the Users tab and cannot sign in."/>
            <DataGrid ItemsSource="{Binding SignInUsers}" SelectedItem="{Binding SelectedAccount}"
                      Height="180"
                      EnableRowVirtualization="True"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditAccountCommand}"/>
              </DataGrid.InputBindings>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120"/>
                <DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="120"/>
                <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16" Cursor="Hand">
          <Border.InputBindings>
            <MouseBinding Gesture="LeftClick" Command="{Binding ToggleDarkModeCommand}"/>
          </Border.InputBindings>
          <DockPanel>
            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding DarkMode, Mode=OneWay}"
                      Style="{StaticResource ThemeSwitch}" VerticalAlignment="Center"
                      IsHitTestVisible="False"/>
            <StackPanel>
              <TextBlock Text="Dark mode" FontWeight="SemiBold"/>
              <TextBlock Text="Dark background for night use. Applies immediately on this PC."
                         Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Categories" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <DataGrid ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                        Height="220"
                        EnableRowVirtualization="True"
                        EnableColumnVirtualization="True"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.CanContentScroll="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/>
                  <DataGridTextColumn Header="Tab" Binding="{Binding FamilyName}" Width="100"/>
                  <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                       IsEnabled="{Binding CanManageCategories}"/>
              <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding CategoryDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                       IsEnabled="{Binding CanManageCategories}"/>
              <TextBlock Text="Shows on" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding FamilyChoices}" SelectedItem="{Binding CategoryFamilyLabel}" Margin="0,0,0,10"
                        IsEnabled="{Binding CanManageCategories}"/>
              <TextBlock Text="{Binding CategoryError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal">
                <Button Content="New" Style="{StaticResource SecondaryButton}" Command="{Binding NewCategoryCommand}" Margin="0,0,6,0"/>
                <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCategoryCommand}"
                        IsEnabled="{Binding CanManageCategories}" Margin="0,0,6,0"/>
                <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCategoryCommand}"
                        IsEnabled="{Binding CanManageCategories}"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Backup and restore" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                       Text="SQLite: copies inventory.db (last 30 kept). SQL Server: writes a data snapshot here; official backup is BACKUP DATABASE on the host. Do not copy a live MDF file."/>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
              <Button Content="Backup now" Style="{StaticResource PrimaryButton}" Command="{Binding BackupNowCommand}"
                      IsEnabled="{Binding CanBackup}" Margin="0,0,8,0"/>
              <Button Content="Restore selected" Style="{StaticResource DangerButton}" Command="{Binding RestoreCommand}"
                      IsEnabled="{Binding CanBackup}"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding BackupMessage}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
            <DataGrid ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}"
                      Height="180"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.CanContentScroll="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*"/>
                <DataGridTextColumn Header="Created (UTC)" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="170"/>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes}" Width="90"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="About" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="PAV IT Inventory for SIDBI" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="Crafted by Jeet Parab" Style="{StaticResource MutedText}" Margin="0,4,0,14"/>

            <TextBlock Text="What it is" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="A lightweight multi-user Windows desktop app that replaces the Excel asset tracker. Built for a small IT team so everyday assign, search, import, and bulk work is faster than a shared spreadsheet."/>

            <TextBlock Text="How it is built" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="No separate web server. Data lives in SQLite (shared file) or optional SQL Server Express on the office LAN. Each engineer runs the desktop client and signs in with a PAV account."/>

            <TextBlock Text="Technology" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,2" Text="• .NET 8 + WPF desktop UI"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,2" Text="• CommunityToolkit.Mvvm (MVVM)"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,2" Text="• Entity Framework Core (SQLite or SQL Server Express)"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,2" Text="• ClosedXML for Excel / CSV import and export"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,2" Text="• PBKDF2 password hashing"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12" Text="• Shared-folder multi-user access (no web server)"/>

            <TextBlock Text="Projects" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,2" Text="• PAV.Client — Windows UI"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,2" Text="• PAV.Core — database, auth, import/export, backup"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,0" Text="• PAV.Shared — models and DTOs"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
