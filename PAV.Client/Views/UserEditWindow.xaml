<Window x:Class="PAV.Client.Views.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,14"/>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True"/>
    </StackPanel>
    <StackPanel>
      <TextBlock Text="Username *" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
      <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
      <PasswordBox x:Name="PasswordBox" Margin="0,0,0,4" Padding="8,6" PasswordChanged="OnPasswordChanged"/>
      <TextBlock Text="Leave blank when editing to keep the current password." Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
      <TextBlock Text="Name *" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
      <TextBlock Text="Employee ID" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding EmployeeId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
      <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
      <TextBlock Text="Department" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
      <TextBlock Text="Location" Style="{StaticResource FieldLabel}"/>
      <ComboBox ItemsSource="{Binding Locations}" SelectedValuePath="Id"
                SelectedValue="{Binding LocationId}" Margin="0,0,0,8">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="Role" Style="{StaticResource FieldLabel}"/>
      <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" Margin="0,0,0,8"/>
      <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,4,0,0"/>
    </StackPanel>
  </DockPanel>
</Window>
