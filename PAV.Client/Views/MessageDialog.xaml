<Window x:Class="PAV.Client.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PAV IT Inventory for SIDBI"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI">
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
    <DockPanel Margin="24,22">
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button x:Name="SecondaryButton" Content="No" Style="{StaticResource SecondaryButton}"
                MinWidth="88" Margin="0,0,8,0" IsCancel="True" Click="OnSecondary"/>
        <Button x:Name="PrimaryButton" Content="Yes" Style="{StaticResource PrimaryButton}"
                MinWidth="88" IsDefault="True" Click="OnPrimary"/>
      </StackPanel>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="IconBadge" Width="40" Height="40" CornerRadius="20"
                VerticalAlignment="Top" Margin="0,0,14,0">
          <TextBlock x:Name="IconGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                     FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                     TextWrapping="Wrap" Margin="0,0,0,6"
                     Foreground="{DynamicResource TextBrush}"/>
          <TextBlock x:Name="MessageText" Style="{StaticResource MutedText}"
                     TextWrapping="Wrap" FontSize="13" LineHeight="18"/>
        </StackPanel>
      </Grid>
    </DockPanel>
  </Border>
</Window>
