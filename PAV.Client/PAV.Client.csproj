<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PAV.Client</RootNamespace>
    <AssemblyName>PAV.Client</AssemblyName>
    <ApplicationIcon>Assets\pav.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationTitle>PAV IT Inventory for SIDBI</ApplicationTitle>
    <Product>PAV IT Inventory for SIDBI</Product>
    <AssemblyTitle>PAV IT Inventory for SIDBI</AssemblyTitle>
    <Company>Jeet Parab</Company>
    <Authors>Jeet Parab</Authors>
    <Description>IT asset inventory for SIDBI — crafted by Jeet Parab</Description>
    <Copyright>Crafted by Jeet Parab</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PAV.Shared\PAV.Shared.csproj" />
    <ProjectReference Include="..\PAV.Core\PAV.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\pav.ico" />
    <Resource Include="Assets\pav.png" />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
